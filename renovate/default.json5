/*
 * The Renovate settings shared by the xwiki-contrib repositories. A repository uses them with:
 *
 *   "extends": ["github>xwiki-contrib/.github//renovate/default.json5"]
 *
 * and then adds whatever is specific to it, if anything. Beware of how Renovate merges the two:
 * "packageRules" of the preset and of the repository are concatenated, the preset's coming first,
 * but every other array is replaced wholesale by the repository's value.
 */
{
  // The settings all the XWiki repositories share. See https://github.com/xwiki/.github
  "extends": ["github>xwiki/.github//renovate/default.json5"],

  // Added to the rules of the xwiki preset, which already disables the commons, rendering, platform and XWiki
  // Enterprise dependencies.
  "packageRules": [
    // Add the URL to the XWiki Nexus public proxy for non-Central Maven dependencies
    {
      "matchDatasources": ["maven"],
      "registryUrls": ["https://repo1.maven.org/maven2/", "https://nexus.xwiki.org/nexus/content/repositories/public/"]
    },

    // There is always a more recent version of contrib parent and we don't want to upgrade just for that
    {
      "matchPackagePrefixes": ["org.xwiki.contrib:parent-"],
      "enabled": false
    }
  ]
}
